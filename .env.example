# Optional. Leave blank to run fully offline with the local extractive answerer.
MINDMESH_PROVIDER=meta        # meta | openai | anthropic
MINDMESH_LLM_BASE_URL=https://api.meta.ai/v1   # base URL only; Ollama: http://localhost:11434/v1
MINDMESH_LLM_API_KEY=
MINDMESH_LLM_MODEL=muse-spark-1.3-contributor
MINDMESH_VISION_MODEL=muse-spark-1.3-contributor   # describes uploaded images (not muse-image)
MINDMESH_SAM_MODEL=sam-3.1   # locates objects in images (Meta API)
MINDMESH_IMAGE_MODEL=muse-image-1.0   # draws visual explanations (Meta API)

# PostgreSQL with pgvector (required). The database is created on first start if missing.
# Put your real password here, in .env only:
MINDMESH_DATABASE_URL=        # postgresql://USER:PASSWORD@localhost:5432/mindmesh
# Embeddings run locally with sentence-transformers/all-MiniLM-L6-v2 (384 dims). "hashing" = offline lexical fallback.
MINDMESH_EMBEDDER=minilm

# Required by Wikipedia/Wikimedia when adding web links (use your own contact details):
# MINDMESH_USER_AGENT="MindMesh/0.1 (https://your-site.example; you@example.com)"
